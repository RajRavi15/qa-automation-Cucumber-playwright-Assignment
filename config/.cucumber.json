{
  "default": {
    "require": ["src/steps/**/*.ts", "src/hooks/**/*.ts"],
    "require-module": ["ts-node/register"],
    "format": [
      "progress",
      "summary",
      "allure-cucumberjs/reporter",
      "json:reports/cucumber-report.json",
      "junit:reports/test-results.xml"
    ],
    "formatOptions": {
      "snippetInterface": "async-await"
    }
  },

  "ui": {
    "tags": "@ui"
  },
  "api": {
    "tags": "@api"
  },
  "smoke": {
    "tags": "@smoke"
  },
  "regression": {
    "tags": "@regression"
  }
}