{
  "name": "playwright-cucumber",
  "version": "1.0.0",
  "description": "Production-ready Playwright BDD automation framework",
  "main": "index.js",
  "scripts": {
  "clean": "rimraf dist test-results allure-results allure-report",

  "build": "tsc",
  "lint": "eslint . --ext .ts",
  "format": "prettier --write .",

  "test": "npm run clean && cucumber-js src/features --require-module ts-node/register --require src/support/**/*.ts --require src/steps/**/*.ts --require src/hooks/**/*.ts --format progress --format summary --format allure-cucumberjs/reporter",
  "test:smoke": "npm run test -- --tags @smoke",
  "test:regression": "npm run test -- --tags @regression",
  "test:ui": "npm run test -- --tags @ui",
  "test:api": "npm run test -- --tags @api",

  "test:parallel": "npm run clean && cucumber-js src/features --parallel 2 --require-module ts-node/register --require src/support/**/*.ts --require src/steps/**/*.ts --require src/hooks/**/*.ts --format progress --format summary --format allure-cucumberjs/reporter",

  "type-check": "tsc --noEmit",

  "report:allure": "allure generate allure-results --clean -o allure-report",
  "report:open": "allure open allure-report",

  "test:ci": "npm run test"
    
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^3.10.0",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2"
  }
}
